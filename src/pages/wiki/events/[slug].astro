---
import { render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { toAbsoluteUrl } from "@/utils/schema-utils";
import {
	getEventUrl,
	getFileDirFromPath,
	getPerformerUrl,
	removeFileExtension,
	url,
} from "@/utils/url-utils";
import {
	buildGoogleCalendarUrl,
	buildIcsContent,
	formatEventDateRange,
	getAdmissionMeta,
	getAllEvents,
	getEventStatusMeta,
	getPerformerInitials,
	normalizeInstagramLink,
	resolveEventLineup,
} from "@/utils/wiki-utils";

export async function getStaticPaths() {
	const events = await getAllEvents();
	return events.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const {
	title,
	startDate,
	endDate,
	venue,
	city,
	region,
	eventType,
	entryType,
	htm,
	time,
	timezone,
	organizer,
	instagram,
	officialUrl,
	mapsUrl,
	highlights,
	status,
	ticketUrl,
	description,
	tags,
	image,
} = entry.data;

const slug = removeFileExtension(entry.id);
const lineupPerformers = await resolveEventLineup(entry);
const dateRange = formatEventDateRange(startDate, endDate);
const statusMeta = getEventStatusMeta(status);
const admissionMeta = getAdmissionMeta(entryType, htm);
const instagramLink = normalizeInstagramLink(instagram);
const startYmd = formatDateToYYYYMMDD(startDate);
const endYmd = endDate ? formatDateToYYYYMMDD(endDate) : startYmd;
const coverBasePath = getFileDirFromPath(entry.filePath || "");

const absoluteEventUrl =
	toAbsoluteUrl(getEventUrl(entry.id), siteConfig.site_url) ??
	siteConfig.site_url;
const googleCalendarUrl = buildGoogleCalendarUrl(entry, absoluteEventUrl);
const icsContent = buildIcsContent(entry, absoluteEventUrl);
---

<MainGridLayout
	title={title}
	description={description || `${title} at ${venue}, ${city}`}
	setOGTypeArticle={true}
	headings={headings}
>
	<div class="flex flex-col gap-4 w-full">
		<article class="card-base px-6 md:px-9 py-6 relative w-full">
			<nav aria-label="Wiki navigation" class="flex flex-wrap items-center gap-3 mb-5 text-sm">
				<a
					href={url("/wiki/events/")}
					class="inline-flex items-center gap-1.5 min-h-[44px] px-2 -ml-2 text-(--primary) font-medium hover:underline"
				>
					<Icon name="material-symbols:arrow-back" class="text-base" aria-hidden="true" />
					<span>All Events & Calendar</span>
				</a>
				<span class="text-neutral-400 dark:text-neutral-500" aria-hidden="true">/</span>
				<a
					href={url("/wiki/performers/")}
					class="inline-flex items-center min-h-[44px] px-2 text-neutral-700 dark:text-neutral-300 hover:text-(--primary) hover:underline"
				>
					Performer Wiki
				</a>
			</nav>

			<header class="pb-6 border-b border-(--line-divider)">
				<div class="flex flex-wrap items-center gap-2.5">
					<h2
						data-pagefind-weight="10"
						data-pagefind-meta="title"
						class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-neutral-100 leading-tight"
					>
						{title}
					</h2>
					<span class={`inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold ${statusMeta.className}`}>
						{statusMeta.label}
					</span>
					<span
						data-event-countdown-start={startYmd}
						data-event-countdown-end={endYmd}
						class="hidden inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-sky-100 text-sky-900 border border-sky-300 dark:bg-sky-950/70 dark:text-sky-200 dark:border-sky-700/60"
					/>
				</div>

				<div class="flex flex-wrap items-center gap-2 mt-3">
					{eventType && (
						<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-neutral-200/75 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
							{eventType}
						</span>
					)}
					<span class={`inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold ${admissionMeta.className}`}>
						{admissionMeta.label}
					</span>
				</div>

				{description && (
					<p class="mt-3 text-sm md:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
						{description}
					</p>
				)}

				<!-- Indonesian ACG Quick Info Box -->
				<dl class="mt-5 grid gap-3 sm:grid-cols-2 rounded-xl border border-(--line-divider) bg-(--page-bg)/60 dark:bg-white/[0.03] p-4">
					<div>
						<dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600 dark:text-neutral-400">
							Date & Hours
						</dt>
						<dd class="mt-1 text-sm font-medium text-neutral-900 dark:text-neutral-100">
							<time datetime={startDate.toISOString()}>{dateRange}</time>
							{time && <span class="block text-xs text-neutral-700 dark:text-neutral-300 mt-0.5">{time} {timezone}</span>}
						</dd>
					</div>

					<div>
						<dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600 dark:text-neutral-400">
							Venue & Region
						</dt>
						<dd class="mt-1 text-sm font-medium text-neutral-900 dark:text-neutral-100">
							<span>{venue}, {city}{region ? ` (${region})` : ""}</span>
							{mapsUrl && (
								<a
									href={mapsUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1 ml-2 text-xs font-semibold text-(--primary) hover:underline"
								>
									<span>Google Maps</span>
									<Icon name="material-symbols:open-in-new-rounded" class="text-xs" aria-hidden="true" />
								</a>
							)}
						</dd>
					</div>

					<div>
						<dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600 dark:text-neutral-400">
							Admission (HTM)
						</dt>
						<dd class="mt-1 text-sm font-medium text-neutral-900 dark:text-neutral-100">
							{admissionMeta.label}
						</dd>
					</div>

					{(organizer || instagramLink || officialUrl) && (
						<div>
							<dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600 dark:text-neutral-400">
								Organizer & Links
							</dt>
							<dd class="mt-1 text-sm font-medium text-neutral-900 dark:text-neutral-100 flex flex-wrap items-center gap-x-3 gap-y-1">
								{organizer && <span>{organizer}</span>}
								{instagramLink && (
									<a
										href={instagramLink.url}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1 text-xs font-semibold text-(--primary) hover:underline"
									>
										<Icon name="fa7-brands:instagram" class="text-sm" aria-hidden="true" />
										<span>{instagramLink.handle}</span>
									</a>
								)}
								{officialUrl && (
									<a
										href={officialUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1 text-xs font-semibold text-(--primary) hover:underline"
									>
										<span>Official Link</span>
										<Icon name="material-symbols:open-in-new-rounded" class="text-xs" aria-hidden="true" />
									</a>
								)}
							</dd>
						</div>
					)}
				</dl>

				{highlights.length > 0 && (
					<div class="mt-4">
						<h3 class="text-xs font-semibold uppercase tracking-wide text-neutral-600 dark:text-neutral-400 mb-2">
							Event Highlights
						</h3>
						<ul role="list" class="flex flex-wrap gap-1.5 list-none p-0 m-0">
							{highlights.map((item) => (
								<li class="px-2.5 py-1 rounded-md text-xs font-medium border border-(--line-divider) text-neutral-800 dark:text-neutral-200">
									{item}
								</li>
							))}
						</ul>
					</div>
				)}

				{tags.length > 0 && (
					<ul
						role="list"
						aria-label="Event tags"
						class="flex flex-wrap gap-1.5 mt-3 list-none p-0 m-0"
					>
						{tags.map((tag) => (
							<li class="px-2.5 py-0.5 rounded-md text-xs font-medium bg-(--btn-regular-bg) text-(--btn-content)">
								#{tag}
							</li>
						))}
					</ul>
				)}

				<div class="mt-5 flex flex-wrap items-center gap-2.5">
					{ticketUrl && (
						<a
							href={ticketUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-lg text-sm font-semibold bg-neutral-900 text-white hover:bg-neutral-700 dark:bg-(--primary) dark:text-neutral-950 dark:hover:opacity-90 transition-colors"
						>
							<span>Get Tickets</span>
							<Icon
								name="material-symbols:open-in-new-rounded"
								class="text-base"
								aria-hidden="true"
							/>
						</a>
					)}

					<a
						href={googleCalendarUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2.5 rounded-lg text-sm font-medium bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) transition-colors"
					>
						<Icon name="material-symbols:event-available-rounded" class="text-base" aria-hidden="true" />
						<span>Add to Google Calendar</span>
					</a>

					<button
						type="button"
						data-ics-download
						data-ics-filename={`${slug}.ics`}
						data-ics-content={icsContent}
						class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2.5 rounded-lg text-sm font-medium border border-(--line-divider) text-neutral-800 dark:text-neutral-200 hover:border-(--primary) hover:text-(--primary) cursor-pointer transition-colors"
					>
						<Icon name="material-symbols:download-rounded" class="text-base" aria-hidden="true" />
						<span>Download .ics</span>
					</button>
				</div>

				{image && (
					<div class="mt-5 overflow-hidden rounded-xl">
						<CoverImage
							src={image}
							basePath={coverBasePath}
							alt={title}
							class="w-full"
							preview={false}
							naturalHeight
						/>
					</div>
				)}
			</header>

			<section aria-labelledby="event-lineup-heading" class="mt-6 pb-6 border-b border-(--line-divider)">
				<h3
					id="event-lineup-heading"
					class="text-lg font-bold text-neutral-900 dark:text-neutral-100 mb-3"
				>
					Lineup ({lineupPerformers.length})
				</h3>

				{lineupPerformers.length > 0 ? (
					<ul
						role="list"
						class="grid gap-3 list-none p-0 m-0"
						style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));"
					>
						{lineupPerformers.map((performer) => {
							const performerAvatar = performer.data.avatar
								? performer.data.avatar.startsWith("/")
									? url(performer.data.avatar)
									: performer.data.avatar
								: "";
							return (
								<li>
									<a
										href={getPerformerUrl(performer.id)}
										class="flex items-center gap-3 p-3 rounded-xl border border-(--line-divider) bg-(--page-bg)/60 dark:bg-white/[0.03] hover:border-(--primary) transition-colors min-h-[60px]"
									>
										{performerAvatar ? (
											<img
												src={performerAvatar}
												alt={performer.data.name}
												width="44"
												height="44"
												loading="lazy"
												decoding="async"
												class="w-11 h-11 rounded-lg object-cover shrink-0 bg-(--btn-regular-bg)"
											/>
										) : (
											<div
												aria-hidden="true"
												class="w-11 h-11 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) flex items-center justify-center text-sm font-bold shrink-0"
											>
												{getPerformerInitials(performer.data.name)}
											</div>
										)}
										<div class="min-w-0">
											<div class="font-bold text-sm text-neutral-900 dark:text-neutral-100 truncate">
												{performer.data.name}
											</div>
											<div class="text-xs text-neutral-600 dark:text-neutral-300 truncate">
												{performer.data.role}
											</div>
										</div>
									</a>
								</li>
							);
						})}
					</ul>
				) : (
					<p class="text-sm text-neutral-600 dark:text-neutral-300">
						Lineup to be announced.
					</p>
				)}
			</section>

			<div class="mt-6">
				<Markdown class="markdown-content">
					<Content />
				</Markdown>
			</div>
		</article>
	</div>
</MainGridLayout>

<script is:inline>
	(function () {
		function parseUtcDayMs(ymd) {
			var parts = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymd || "");
			if (!parts) return NaN;
			return Date.UTC(Number(parts[1]), Number(parts[2]) - 1, Number(parts[3]));
		}

		function updateDetailCountdowns() {
			var todayYmd;
			try {
				todayYmd = new Intl.DateTimeFormat("en-CA", {
					timeZone: "Asia/Jakarta",
				}).format(new Date());
			} catch {
				todayYmd = new Date().toISOString().slice(0, 10);
			}
			var todayMs = parseUtcDayMs(todayYmd);
			var todayDow = new Date(todayMs).getUTCDay();

			document.querySelectorAll("[data-event-countdown-start]").forEach(function (el) {
				var startYmd = el.getAttribute("data-event-countdown-start") || "";
				var endYmd = el.getAttribute("data-event-countdown-end") || startYmd;
				var startMs = parseUtcDayMs(startYmd);
				var endMs = parseUtcDayMs(endYmd);
				if (Number.isNaN(startMs) || Number.isNaN(endMs)) return;

				var diffStart = Math.round((startMs - todayMs) / 86400000);
				var diffEnd = Math.round((endMs - todayMs) / 86400000);
				var label = "";

				if (diffEnd < 0) {
					label = "Ended";
				} else if (diffStart <= 0 && diffEnd >= 0) {
					label = startYmd === endYmd ? "Today" : "Ongoing";
				} else if (diffStart === 1) {
					label = "Tomorrow";
				} else if (diffStart <= 6) {
					var startDow = new Date(startMs).getUTCDay();
					var daysUntilSat = (6 - todayDow + 7) % 7;
					label =
						(startDow === 0 || startDow === 6) && diffStart <= daysUntilSat + 1
							? "This Weekend"
							: "In " + diffStart + " days";
				} else if (diffStart <= 30) {
					label = "In " + diffStart + " days";
				}

				if (label) {
					el.textContent = label;
					el.classList.remove("hidden");
				}
			});
		}

		if (!window.__eventDetailActionsBound) {
			window.__eventDetailActionsBound = true;
			document.addEventListener("click", function (e) {
				var btn = e.target.closest("[data-ics-download]");
				if (!btn) return;
				var content = btn.getAttribute("data-ics-content");
				var filename = btn.getAttribute("data-ics-filename") || "event.ics";
				if (!content) return;
				var blob = new Blob([content], { type: "text/calendar;charset=utf-8" });
				var blobUrl = URL.createObjectURL(blob);
				var a = document.createElement("a");
				a.href = blobUrl;
				a.download = filename;
				document.body.appendChild(a);
				a.click();
				a.remove();
				setTimeout(function () {
					URL.revokeObjectURL(blobUrl);
				}, 1000);
			});
			document.addEventListener("DOMContentLoaded", updateDetailCountdowns);
			document.addEventListener("astro:page-load", updateDetailCountdowns);
		}
		updateDetailCountdowns();
	})();
</script>
