---
import { getEventUrl, removeFileExtension } from "@/utils/url-utils";
import { getAllEvents } from "@/utils/wiki-utils";

export async function getStaticPaths() {
	const events = await getAllEvents();
	return events.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { target: getEventUrl(entry.id), title: entry.data.title },
	}));
}

const { target, title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Redirecting to {title}</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={target} />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<script is:inline define:vars={{ target }}>
			window.location.replace(target);
		</script>
	</head>
	<body>
		<p>
			Moved to <a href={target}>{title}</a>.
		</p>
	</body>
</html>
