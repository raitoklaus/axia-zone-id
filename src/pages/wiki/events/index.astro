---
import { Icon } from "astro-icon/components";
import EventCalendarBrowser from "@/components/wiki/EventCalendarBrowser.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import { serializeEventsForBrowser } from "@/utils/wiki-utils";

const title = "Events & Schedule";
const description =
	"Indonesian ACG conventions, mall matsuri, anisong concerts, anikura DJ nights, and event archive.";

const serializedEvents = await serializeEventsForBrowser();
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell">
		<header class="axia-sekai-heading">
			<span class="axia-sekai-watermark" aria-hidden="true">
				EVENTS &nbsp; EVENTS &nbsp; EVENTS
			</span>
			<h2 class="axia-sekai-title">{title}</h2>
			<div class="axia-sekai-rule" aria-hidden="true"></div>
			<p class="axia-sekai-subtitle">{description}</p>
			<div class="mt-3 inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white dark:bg-[#1c2236] border border-black/10 dark:border-white/12 text-xs font-bold text-[#2b314a] dark:text-slate-200 relative z-10 shadow-xs">
				<Icon name="material-symbols:calendar-month-rounded" class="text-sm text-[#0c6fc4] dark:text-[#5ce1ff]" aria-hidden="true" />
				<span>{serializedEvents.length} Indexed Events</span>
			</div>
		</header>

		<EventCalendarBrowser client:load events={serializedEvents} />
	</section>
</MainGridLayout>
