---
import { render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import WikiBacklinks from "@/components/wiki/WikiBacklinks.astro";
import WikiInfobox, {
	type InfoboxRow,
} from "@/components/wiki/WikiInfobox.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getEventUrl, removeFileExtension, url } from "@/utils/url-utils";
import {
	formatEventDateRange,
	getAdmissionMeta,
	getAllPerformers,
	getBacklinksForTarget,
	getEventStatusMeta,
	getEventsForPerformer,
	getPerformerInitials,
} from "@/utils/wiki-utils";

export async function getStaticPaths() {
	const performers = await getAllPerformers();
	return performers.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const {
	name,
	role,
	category,
	bio,
	socials,
	tags,
	avatar,
	aliases,
	city,
	activeYears,
	affiliation,
	status,
	infobox,
} = entry.data;
const slug = removeFileExtension(entry.id);
const initials = getPerformerInitials(name);

const [{ upcoming, past }, backlinks] = await Promise.all([
	getEventsForPerformer(entry.id),
	getBacklinksForTarget("performers", entry.id),
]);

const infoboxRows: InfoboxRow[] = [
	{ label: "Category", value: category || "Performer" },
	{ label: "Role", value: role },
	...(aliases.length > 0
		? [{ label: "Aliases", value: aliases.join(", ") }]
		: []),
	...(city ? [{ label: "Base City", value: city }] : []),
	...(activeYears ? [{ label: "Active Years", value: activeYears }] : []),
	...(affiliation ? [{ label: "Affiliation", value: affiliation }] : []),
	...(status ? [{ label: "Status", value: status }] : []),
	...infobox,
];
---

<MainGridLayout
	title={name}
	description={bio || `${name} (${role})`}
	ogImagePath={`/og/performers/${slug}.png`}
	headings={headings}
>
	<div class="flex flex-col gap-4 w-full">
		<article data-pagefind-body class="card-base overflow-hidden relative w-full">
			<div class="axia-split-bar" data-pagefind-ignore>
				<span class="axia-split-date">{category || "Performer"}</span>
				<span class="axia-split-type" data-cat-tone="blog">
					<span class="truncate">{role}</span>
				</span>
			</div>
			<div class="px-6 md:px-9 py-6">
			<nav data-pagefind-ignore aria-label="Wiki navigation" class="flex flex-wrap items-center gap-2.5 mb-5 text-sm">
				<a
					href={url("/wiki/")}
					class="inline-flex items-center gap-1.5 min-h-[44px] px-2 -ml-2 text-(--primary) font-medium hover:underline"
				>
					<Icon name="material-symbols:arrow-back" class="text-base" aria-hidden="true" />
					<span>Wiki Hub</span>
				</a>
				<span class="text-neutral-400 dark:text-neutral-500" aria-hidden="true">/</span>
				<a
					href={url("/wiki/performers/")}
					class="inline-flex items-center min-h-[44px] px-2 text-(--primary) font-medium hover:underline"
				>
					Performers
				</a>
				<span class="text-neutral-400 dark:text-neutral-500" aria-hidden="true">/</span>
				<a
					href={url("/events/")}
					class="inline-flex items-center min-h-[44px] px-2 text-neutral-700 dark:text-neutral-300 hover:text-(--primary) hover:underline"
				>
					Event Calendar
				</a>
			</nav>

			<header class="flex flex-col md:flex-row md:items-start gap-6 pb-6 border-b border-(--line-divider)">
				<div class="min-w-0 flex-1">
					<div class="flex flex-wrap items-center gap-2.5">
						<h2
							data-pagefind-weight="10"
							data-pagefind-meta="title"
							class="text-2xl md:text-3xl font-extrabold text-[#2b314a] dark:text-slate-100 leading-tight"
							style="font-family: var(--font-montserrat, sans-serif)"
						>
							{name}
						</h2>
						{category && (
							<span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-(--btn-regular-bg) text-(--btn-content)">
								{category}
							</span>
						)}
					</div>

					<p class="text-base font-medium text-(--primary) mt-1">
						{role}
					</p>

					{bio && (
						<p class="mt-2.5 text-sm md:text-base text-[#4a5170] dark:text-slate-300 leading-relaxed">
							{bio}
						</p>
					)}

					{tags.length > 0 && (
						<ul
							role="list"
							aria-label="Performer tags"
							class="flex flex-wrap gap-1.5 mt-3 list-none p-0 m-0"
						>
							{tags.map((tag) => (
								<li class="px-2.5 py-0.5 rounded-md text-xs font-medium bg-(--btn-regular-bg) text-(--btn-content)">
									#{tag}
								</li>
							))}
						</ul>
					)}
				</div>

				<WikiInfobox
					title={name}
					category={category || "Performer"}
					tone="blog"
					subtitle={role}
					image={avatar}
					initials={initials}
					rows={infoboxRows}
					links={socials}
				/>
			</header>

			<div class="mt-6">
				<Markdown class="markdown-content" pagefindBody={false}>
					<Content />
				</Markdown>
			</div>
			</div>
		</article>

		<section
			aria-labelledby="performer-appearances-heading"
			class="card-base px-6 md:px-9 py-6 w-full"
		>
			<h2
				id="performer-appearances-heading"
				class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-neutral-100"
			>
				Event Appearances
			</h2>

			<div class="grid gap-6 md:grid-cols-2 mt-4">
				<div>
					<h3 class="text-base font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-2 mb-3">
						<Icon
							name="material-symbols:upcoming-rounded"
							class="text-lg text-(--primary)"
							aria-hidden="true"
						/>
						<span>Upcoming Appearances ({upcoming.length})</span>
					</h3>

					{upcoming.length > 0 ? (
						<ul role="list" class="flex flex-col gap-3 list-none p-0 m-0">
							{upcoming.map((event) => {
								const statusMeta = getEventStatusMeta(event.data.status);
								const admissionMeta = getAdmissionMeta(
									event.data.entryType,
									event.data.htm,
								);
								return (
									<li class="rounded-xl border border-(--line-divider) p-4 bg-(--page-bg)/60 dark:bg-white/[0.03]">
										<div class="flex flex-wrap items-center justify-between gap-2">
											<a
												href={getEventUrl(event.id)}
												class="text-base font-bold text-neutral-900 dark:text-neutral-100 hover:text-(--primary) transition-colors"
											>
												{event.data.title}
											</a>
											<span class={`px-2 py-0.5 rounded-md text-xs font-medium ${statusMeta.className}`}>
												{statusMeta.label}
											</span>
										</div>
										<div class="flex flex-wrap items-center gap-1.5 mt-2">
											{event.data.eventType && (
												<span class="px-2 py-0.5 rounded-md text-xs font-medium bg-neutral-200/75 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
													{event.data.eventType}
												</span>
											)}
											<span class={`px-2 py-0.5 rounded-md text-xs font-semibold ${admissionMeta.className}`}>
												{admissionMeta.label}
											</span>
										</div>
										<p class="text-sm text-neutral-600 dark:text-neutral-300 mt-1.5">
											<time datetime={event.data.startDate.toISOString()}>
												{formatEventDateRange(event.data.startDate, event.data.endDate)}
											</time>
											{" · "}
											{event.data.venue}, {event.data.city}
											{event.data.region ? ` (${event.data.region})` : ""}
										</p>
										{event.data.ticketUrl && (
											<a
												href={event.data.ticketUrl}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex items-center gap-1 mt-2.5 text-xs font-semibold text-(--primary) hover:underline py-1"
											>
												<span>Tickets</span>
												<span class="sr-only"> for {event.data.title}</span>
												<Icon
													name="material-symbols:open-in-new-rounded"
													class="text-sm"
													aria-hidden="true"
												/>
											</a>
										)}
									</li>
								);
							})}
						</ul>
					) : (
						<p class="text-sm text-neutral-600 dark:text-neutral-300 rounded-xl border border-dashed border-(--line-divider) p-4">
							No upcoming events listed for {name} yet.
						</p>
					)}
				</div>

				<div>
					<h3 class="text-base font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-2 mb-3">
						<Icon
							name="material-symbols:history-rounded"
							class="text-lg text-neutral-600 dark:text-neutral-300"
							aria-hidden="true"
						/>
						<span>Past Appearances ({past.length})</span>
					</h3>

					{past.length > 0 ? (
						<ul role="list" class="flex flex-col gap-3 list-none p-0 m-0">
							{past.map((event) => {
								const statusMeta = getEventStatusMeta(event.data.status);
								const admissionMeta = getAdmissionMeta(
									event.data.entryType,
									event.data.htm,
								);
								return (
									<li class="rounded-xl border border-(--line-divider) p-4 bg-(--page-bg)/60 dark:bg-white/[0.03]">
										<div class="flex flex-wrap items-center justify-between gap-2">
											<a
												href={getEventUrl(event.id)}
												class="text-base font-bold text-neutral-900 dark:text-neutral-100 hover:text-(--primary) transition-colors"
											>
												{event.data.title}
											</a>
											<span class={`px-2 py-0.5 rounded-md text-xs font-medium ${statusMeta.className}`}>
												{statusMeta.label}
											</span>
										</div>
										<div class="flex flex-wrap items-center gap-1.5 mt-2">
											{event.data.eventType && (
												<span class="px-2 py-0.5 rounded-md text-xs font-medium bg-neutral-200/75 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
													{event.data.eventType}
												</span>
											)}
											<span class={`px-2 py-0.5 rounded-md text-xs font-semibold ${admissionMeta.className}`}>
												{admissionMeta.label}
											</span>
										</div>
										<p class="text-sm text-neutral-600 dark:text-neutral-300 mt-1.5">
											<time datetime={event.data.startDate.toISOString()}>
												{formatEventDateRange(event.data.startDate, event.data.endDate)}
											</time>
											{" · "}
											{event.data.venue}, {event.data.city}
											{event.data.region ? ` (${event.data.region})` : ""}
										</p>
									</li>
								);
							})}
						</ul>
					) : (
						<p class="text-sm text-neutral-600 dark:text-neutral-300 rounded-xl border border-dashed border-(--line-divider) p-4">
							No past appearances recorded yet.
						</p>
					)}
				</div>
			</div>
		</section>

		<WikiBacklinks items={backlinks} />
	</div>
</MainGridLayout>
