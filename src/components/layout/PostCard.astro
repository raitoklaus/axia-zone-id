---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import PostStats from "@/components/layout/PostStats.astro";
import { siteConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import {
	getApiUrlList,
	processCoverImageSync,
	resolvePostCoverInput,
} from "@/utils/image-utils";
import { getFileDirFromPath, getTagUrl } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	password?: boolean;
	style: string;
	loading?: "lazy" | "eager";
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	pinned,
	password,
	style,
	loading = "lazy",
} = Astro.props;
const className = Astro.props.class;

const displayDotDate = formatDateToYYYYMMDD(published).replaceAll("-", ".");

// Handle random cover API when image is "api" or useRandomCover is enabled
const coverInput = resolvePostCoverInput(image, entry.data.useRandomCover);
const processedImage = processCoverImageSync(coverInput, entry.id);
const apiUrls = getApiUrlList(coverInput, entry.id);
const hasCover =
	processedImage !== undefined &&
	processedImage !== null &&
	processedImage !== "";

const coverWidth = "32%";
const gridCoverFullWidth =
	siteConfig.postListLayout.grid.coverFullWidth ?? false;

const descriptionLines = Math.max(
	0,
	Math.trunc(siteConfig.postListLayout.descriptionLines ?? 2),
);

const metaConfig = siteConfig.postListLayout.meta ?? {};
const showCategory = metaConfig.showCategory ?? true;
const metaShowTags = metaConfig.showTags ?? true;
const metaTagCount =
	metaConfig.tagCount !== undefined
		? Math.max(0, Math.trunc(metaConfig.tagCount))
		: 1;
const metaShowWords = metaConfig.showWords ?? true;
const metaShowReadingTime = metaConfig.showReadingTime ?? true;
const metaShowPublished = metaConfig.showPublished ?? true;

const statsConfig = siteConfig.postListLayout.stats ?? {};
const statsShowPublished = statsConfig.showPublished ?? true;
const statsShowWords = statsConfig.showWords ?? true;
const statsShowReadingTime = statsConfig.showReadingTime ?? true;

const tagsPosition = siteConfig.postListLayout.tagsPosition ?? "meta";
const showTagsInMeta = metaShowTags && tagsPosition === "meta";
const showTagsAtBottom = metaShowTags && tagsPosition === "bottom";
const bottomTagsAsText =
	(siteConfig.postListLayout.tagsBottomStyle ?? "chip") === "text";
const descriptionClampLines = String(descriptionLines);
const shouldClampDescription = descriptionLines > 0;

const tagList = tags ?? [];
const bottomTags = metaTagCount > 0 ? tagList.slice(0, metaTagCount) : tagList;
const hiddenTags = tagList.slice(bottomTags.length);
const hiddenTagCount = hiddenTags.length;

const { remarkPluginFrontmatter } = await render(entry);
const descriptionText = description || remarkPluginFrontmatter.excerpt || "";
const words = remarkPluginFrontmatter.words;
const minutes = remarkPluginFrontmatter.minutes;
---

<article
  class:list={[
    "card-base post-card-wrapper axia-sekai-post-card",
    hasCover ? "has-cover" : "no-cover",
    pinned ? "pinned" : "",
    gridCoverFullWidth ? "" : "grid-cover-inset",
    "flex flex-col w-full overflow-hidden relative",
    className,
  ]}
  style={style}
>
  <div class="axia-split-bar shrink-0">
    <time datetime={published.toISOString()} class="axia-split-date">
      <span>{displayDotDate}</span>
    </time>
    <div class="axia-split-type" data-cat-tone="blog">
      <span class="truncate">{category?.trim() || "Article"}</span>
      {pinned && (
        <span class="shrink-0 inline-flex items-center gap-1 opacity-95">
          <Icon name="material-symbols:keep-rounded" class="text-sm" aria-hidden="true" />
          <span>Pinned</span>
        </span>
      )}
    </div>
  </div>

  <div class="post-card-main flex flex-col flex-1 min-w-0 relative">
    {
      hasCover ? (
        <a
          href={url}
          aria-label={title}
          class="post-card-image group block relative overflow-hidden shrink-0"
        >
          <div class="absolute inset-0 pointer-events-none z-10 group-hover:bg-black/25 transition-colors flex items-center justify-center">
            <Icon
              name="material-symbols:chevron-right-rounded"
              class="text-4xl text-white opacity-0 scale-90 group-hover:opacity-100 group-hover:scale-100 transition-all duration-200"
              aria-hidden="true"
            />
          </div>
          <CoverImage
            src={processedImage}
            basePath={getFileDirFromPath(entry.filePath || "")}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            preview={true}
            loading={loading}
            apiUrls={apiUrls}
          />
        </a>
      ) : (
        <a
          href={url}
          aria-label={title}
          class="post-card-enter-btn hidden btn-regular w-13 active:scale-95 items-center justify-center shrink-0 rounded-xl m-3"
        >
          <Icon
            name="material-symbols:chevron-right-rounded"
            class="text-(--primary) text-3xl"
            aria-hidden="true"
          />
        </a>
      )
    }

    <div class="post-card-content p-4 md:p-5 relative flex flex-col flex-1 min-w-0">
      <h3 class="mb-2 leading-snug">
        <a
          href={url}
          class="post-card-title transition group block font-bold text-xl md:text-2xl text-[#2b314a] dark:text-slate-100 hover:text-(--primary) dark:hover:text-[#7ee8ff]"
          style="font-family: var(--font-montserrat, inherit)"
        >
          {title}
          {
            password && (
              <Icon
                name="material-symbols:lock-outline"
                class="inline text-xl align-middle -translate-y-px ml-1"
              />
            )
          }
        </a>
      </h3>

      <PostMetadata
        published={published}
        tags={tags}
        showPublished={metaShowPublished}
        showCategory={showCategory}
        showTags={showTagsInMeta}
        maxTags={metaTagCount > 0 ? metaTagCount : undefined}
        showNoTags={true}
        hideUpdateDate={true}
        category={category || undefined}
        pinned={pinned}
        words={words}
        minutes={minutes}
        showWords={metaShowWords}
        showReadingTime={metaShowReadingTime}
        className="mb-2.5 post-meta card-header-meta"
      />

      <p
        class:list={[
          "description transition text-sm md:text-[0.95rem] leading-relaxed text-[#4a5170] dark:text-slate-300 grow",
          { "description-clamped": shouldClampDescription },
        ]}
        title={descriptionText}
      >
        {descriptionText}
      </p>

      <div class="mt-auto pt-3.5 mt-3.5 border-t border-black/8 dark:border-white/10 flex flex-wrap items-center justify-between gap-2">
        {showTagsAtBottom && bottomTags.length > 0 ? (
          <div
            class:list={[
              "post-card-bottom-tags flex flex-wrap items-center",
              bottomTagsAsText ? "gap-x-3 gap-y-1" : "gap-1.5",
            ]}
          >
            {bottomTags.map((tag) => (
              <a
                href={getTagUrl(tag)}
                aria-label={`View all posts with the ${tag.trim()} tag`}
                class:list={[
                  "transition text-xs font-medium",
                  bottomTagsAsText
                    ? "text-50 hover:text-(--primary)"
                    : "tag-item px-2.5 py-1",
                ]}
              >
                #{tag.trim()}
              </a>
            ))}
            {hiddenTagCount > 0 && (
              <span
                title={hiddenTags.map((tag) => `#${tag.trim()}`).join(" ")}
                class:list={[
                  "text-xs font-medium",
                  bottomTagsAsText
                    ? "text-50"
                    : "tag-item tag-item-static px-2.5 py-1",
                ]}
              >
                +{hiddenTagCount}
              </span>
            )}
          </div>
        ) : (
          <PostStats
            published={published}
            words={words}
            minutes={minutes}
            showPublished={statsShowPublished}
            showWords={statsShowWords}
            showReadingTime={statsShowReadingTime}
            showIcons={siteConfig.postListLayout.showStatsIcons}
            className="stats text-xs text-[#4a5170] dark:text-slate-300 gap-x-2"
          />
        )}

        <a
          href={url}
          class="inline-flex items-center gap-1 min-h-[44px] sm:min-h-[34px] text-xs font-bold uppercase tracking-wider text-(--primary) dark:text-[#7ee8ff] hover:underline ml-auto"
          style="font-family: var(--font-montserrat, sans-serif)"
        >
          <span>Read Article</span>
          <Icon name="material-symbols:chevron-right-rounded" class="text-base" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</article>

<style define:vars={{ coverWidth, descriptionClampLines }}>
  .description-clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-line-clamp: var(--descriptionClampLines);
    line-clamp: var(--descriptionClampLines);
  }

  /* Grid Mode: image on top under split bar */
  :global(.grid-mode) .post-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  :global(.grid-mode) .post-card-wrapper.grid-cover-inset .post-card-image {
    width: calc(100% - var(--grid-card-padding, 1.5rem) * 2);
    margin: var(--grid-card-padding, 1.5rem) var(--grid-card-padding, 1.5rem) 0;
    border-radius: 0.75rem;
  }

  /* Single featured post in grid mode */
  @media (min-width: 768px) {
    :global(.grid-mode.single-featured-post) .has-cover .post-card-main {
      display: grid;
      grid-template-columns: minmax(min(100%, 240px), 42%) minmax(0, 1fr);
      align-items: stretch;
    }
    :global(.grid-mode.single-featured-post) .has-cover .post-card-image {
      aspect-ratio: auto;
      min-height: 220px;
      height: 100%;
    }
    :global(.grid-mode.single-featured-post) .grid-cover-inset .post-card-image {
      width: auto;
      height: auto;
      margin: var(--grid-card-padding, 1.5rem) 0 var(--grid-card-padding, 1.5rem) var(--grid-card-padding, 1.5rem);
      border-radius: 0.75rem;
    }
  }

  /* List Mode: desktop side-by-side */
  @media (min-width: 768px) {
    :global(.list-mode) .post-card-main {
      flex-direction: row-reverse;
      align-items: stretch;
    }
    :global(.list-mode.cover-left) .post-card-main {
      flex-direction: row;
    }
    :global(.list-mode) .has-cover .post-card-image {
      width: var(--coverWidth);
      margin: 0.875rem 0.875rem 0.875rem 0;
      border-radius: 0.75rem;
      aspect-ratio: 16 / 10;
      flex-shrink: 0;
    }
    :global(.list-mode.cover-left) .has-cover .post-card-image {
      margin: 0.875rem 0 0.875rem 0.875rem;
    }
    :global(.list-mode) .no-cover .post-card-enter-btn {
      display: flex;
    }
  }

  /* Mobile List Mode */
  @media (max-width: 767px) {
    :global(.list-mode) .post-card-image {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>
