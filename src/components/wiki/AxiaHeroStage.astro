---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import axiaAvatar from "@/assets/images/axia-avatar.jpg";
import { siteConfig } from "@/config";
import { getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";
import { getAllPerformers, getUpcomingEvents } from "@/utils/wiki-utils";

const [upcomingEvents, performers, posts] = await Promise.all([
	getUpcomingEvents(),
	getAllPerformers(),
	getSortedPostsList(),
]);
---

<section
	aria-label="Axia Zone ID introduction"
	class="axia-hero-stage onload-animation"
>
	<div class="axia-hero-grid">
		<div class="axia-hero-copy">
			<p class="axia-hero-kicker">
				Indonesian ACG Hub &middot; Event Schedule &middot; Performer Wiki
			</p>
			<div class="axia-hero-wordmark" style="font-family: var(--font-montserrat, sans-serif)">
				AXIA <span class="axia-hero-accent">ZONE ID</span>
			</div>
			<p class="axia-hero-lead">
				{siteConfig.description}
			</p>

			<dl class="axia-hero-stats" aria-label="Live directory index counts">
				<a href={url("/wiki/events/")} class="axia-stat-link">
					<dt>Upcoming Events</dt>
					<dd>{upcomingEvents.length}</dd>
				</a>
				<a href={url("/wiki/performers/")} class="axia-stat-link">
					<dt>Performers</dt>
					<dd>{performers.length}</dd>
				</a>
				<a href={url("/archive/")} class="axia-stat-link">
					<dt>Articles</dt>
					<dd>{posts.length}</dd>
				</a>
			</dl>

			<div class="axia-hero-actions">
				<a href={url("/wiki/events/")} class="axia-stage-btn axia-stage-btn-cyan">
					<Icon name="material-symbols:calendar-month-rounded" class="text-lg" aria-hidden="true" />
					<span>Event Schedule</span>
				</a>
				<a href={url("/wiki/performers/")} class="axia-stage-btn axia-stage-btn-outline">
					<Icon name="material-symbols:groups-rounded" class="text-lg" aria-hidden="true" />
					<span>Performer Wiki</span>
				</a>
			</div>
		</div>

		<div class="axia-hero-visual">
			<div class="axia-hero-backdrop-plate" aria-hidden="true"></div>
			<div class="axia-hero-card">
				<Picture
					src={axiaAvatar}
					widths={[320, 540]}
					sizes="(max-width: 767px) 220px, 320px"
					formats={["webp"]}
					fallbackFormat="jpeg"
					alt="Axia character artwork in crisp electric azure and charcoal sailor outfit"
					loading="eager"
					fetchpriority="high"
					class="axia-hero-art"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.axia-hero-stage {
		position: relative;
		overflow: hidden;
		margin-top: 1.25rem;
		margin-bottom: 2.5rem;
		border-radius: 6px;
		border: 1px solid rgba(47, 53, 80, 0.10);
		background:
			repeating-linear-gradient(
				-28deg,
				rgba(255, 255, 255, 0.45) 0px,
				rgba(255, 255, 255, 0.45) 28px,
				transparent 28px,
				transparent 72px
			),
			linear-gradient(118deg, #e7f9ff 0%, #ffffff 48%, #ebf0ff 100%);
		box-shadow: 0 14px 36px -12px rgba(47, 53, 80, 0.16);
	}

	:global(:root.dark) .axia-hero-stage {
		border-color: rgba(125, 211, 252, 0.18);
		background:
			repeating-linear-gradient(
				-28deg,
				rgba(255, 255, 255, 0.025) 0px,
				rgba(255, 255, 255, 0.025) 28px,
				transparent 28px,
				transparent 72px
			),
			linear-gradient(118deg, #161e34 0%, #1d2642 52%, #231e3f 100%);
		box-shadow: 0 16px 38px -12px rgba(0, 0, 0, 0.52);
	}

	.axia-hero-stage::after {
		content: "";
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		height: 3px;
		background: linear-gradient(90deg, #2f3550 0%, #1898f2 52%, #5ce1ff 100%);
	}

	.axia-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		gap: 1.75rem;
		padding: 1.75rem 1.5rem 2rem;
	}

	@media (min-width: 860px) {
		.axia-hero-grid {
			grid-template-columns: minmax(0, 1.3fr) minmax(240px, 0.7fr);
			gap: 2.5rem;
			padding: 2.5rem 3rem;
		}
	}

	.axia-hero-kicker {
		margin: 0 0 0.55rem;
		font-family: var(--font-montserrat, "Montserrat", sans-serif);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #0c6fc4;
	}

	:global(:root.dark) .axia-hero-kicker {
		color: #7ee8ff;
	}

	.axia-hero-wordmark {
		font-size: clamp(2.1rem, 1.35rem + 2.6vw, 3.4rem);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: #2b314a;
	}

	:global(:root.dark) .axia-hero-wordmark {
		color: #f8fafc;
	}

	.axia-hero-accent {
		color: #0c6fc4;
	}

	:global(:root.dark) .axia-hero-accent {
		color: #5ce1ff;
	}

	.axia-hero-lead {
		margin: 0.85rem 0 0;
		max-width: 36rem;
		font-size: 1rem;
		line-height: 1.6;
		color: #4b526e;
	}

	:global(:root.dark) .axia-hero-lead {
		color: #cbd5e1;
	}

	.axia-hero-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin: 1.35rem 0 0;
		padding: 0;
	}

	.axia-stat-link {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.15rem;
		padding: 0.35rem 0.85rem 0.35rem 0;
		border-right: 1px solid rgba(47, 53, 80, 0.14);
		text-decoration: none;
		transition: color 0.18s ease;
	}

	.axia-stat-link:last-child {
		border-right: none;
	}

	:global(:root.dark) .axia-stat-link {
		border-right-color: rgba(255, 255, 255, 0.14);
	}

	.axia-stat-link dt {
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: #4b526e;
	}

	:global(:root.dark) .axia-stat-link dt {
		color: #cbd5e1;
	}

	.axia-stat-link dd {
		margin: 0;
		font-family: var(--font-montserrat, "Montserrat", sans-serif);
		font-size: 1.45rem;
		font-weight: 800;
		line-height: 1.1;
		color: #2b314a;
	}

	:global(:root.dark) .axia-stat-link dd {
		color: #f8fafc;
	}

	.axia-stat-link:hover dd {
		color: #0c6fc4;
	}

	:global(:root.dark) .axia-stat-link:hover dd {
		color: #5ce1ff;
	}

	.axia-hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
		margin-top: 1.6rem;
	}

	.axia-hero-visual {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		max-width: 225px;
		margin-inline: auto;
	}

	.axia-hero-backdrop-plate {
		position: absolute;
		inset: 0.55rem -0.5rem -0.5rem 0.55rem;
		border-radius: 6px;
		background: linear-gradient(135deg, #5ce1ff 0%, #1898f2 100%);
		opacity: 0.9;
	}

	.axia-hero-card {
		position: relative;
		z-index: 1;
		width: 100%;
		border-radius: 6px;
		overflow: hidden;
		background-color: #ffffff;
		border: 1px solid rgba(47, 53, 80, 0.14);
		box-shadow: 0 12px 28px -8px rgba(47, 53, 80, 0.22);
		padding: 0.25rem;
	}

	.axia-hero-art {
		display: block;
		width: 100%;
		height: auto;
		max-height: 290px;
		object-fit: contain;
	}

	@media (max-width: 859px) {
		.axia-hero-visual {
			max-width: 175px;
		}
		.axia-hero-art {
			max-height: 220px;
		}
		.axia-hero-actions {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
