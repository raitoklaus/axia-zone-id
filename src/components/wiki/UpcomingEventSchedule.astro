---
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getEventUrl, getPerformerUrl, url } from "@/utils/url-utils";
import {
	formatEventDateRange,
	getAdmissionMeta,
	getEventCalendarParts,
	getEventStatusMeta,
	getUpcomingEvents,
	resolveEventLineup,
} from "@/utils/wiki-utils";

const upcomingEvents = await getUpcomingEvents(6);
const eventsWithMeta = await Promise.all(
	upcomingEvents.map(async (event) => {
		const startYmd = formatDateToYYYYMMDD(event.data.startDate);
		const endYmd = event.data.endDate
			? formatDateToYYYYMMDD(event.data.endDate)
			: startYmd;
		return {
			event,
			startYmd,
			endYmd,
			lineup: await resolveEventLineup(event),
			dateParts: getEventCalendarParts(event.data.startDate),
			dateRange: formatEventDateRange(event.data.startDate, event.data.endDate),
			statusMeta: getEventStatusMeta(event.data.status),
			admissionMeta: getAdmissionMeta(event.data.entryType, event.data.htm),
		};
	}),
);

const availableRegions = Array.from(
	new Set(
		eventsWithMeta
			.map(({ event }) => event.data.region.trim())
			.filter((region) => region.length > 0),
	),
);
---

<section
	aria-labelledby="upcoming-schedule-heading"
	class="card-base p-5 md:p-6 mb-4 onload-animation"
>
	<home-schedule-filter class="block">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex items-center gap-2.5 min-w-0">
				<div
					class="w-9 h-9 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) flex items-center justify-center shrink-0"
					aria-hidden="true"
				>
					<Icon name="material-symbols:calendar-month-rounded" class="text-xl" />
				</div>
				<div>
					<h2
						id="upcoming-schedule-heading"
						class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-neutral-100 leading-tight"
					>
						Upcoming Event Schedule
					</h2>
					<p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300">
						Indonesian ACG conventions, mall matsuri, anisong lives, and performer lineups
					</p>
				</div>
			</div>

			<nav aria-label="Event and performer wiki links" class="flex flex-wrap items-center gap-2">
				<a
					href={url("/wiki/events/")}
					class="inline-flex items-center gap-1.5 min-h-[44px] px-3 py-2 rounded-lg text-sm font-medium bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) active:bg-(--btn-regular-bg-active) transition-colors"
				>
					<Icon name="material-symbols:event-note-rounded" class="text-base" aria-hidden="true" />
					<span>All Events & Calendar</span>
				</a>
				<a
					href={url("/wiki/performers/")}
					class="inline-flex items-center gap-1.5 min-h-[44px] px-3 py-2 rounded-lg text-sm font-medium border border-(--line-divider) text-neutral-800 dark:text-neutral-200 hover:border-(--primary) hover:text-(--primary) transition-colors"
				>
					<Icon name="material-symbols:groups-rounded" class="text-base" aria-hidden="true" />
					<span>Performer Wiki</span>
				</a>
			</nav>
		</div>

		{
			availableRegions.length > 1 && (
				<div
					class="flex flex-wrap items-center gap-2 mt-4"
					role="group"
					aria-label="Filter upcoming schedule by region"
				>
					<button
						type="button"
						data-region="all"
						data-active
						aria-pressed="true"
						class="home-region-pill min-h-[44px] px-3.5 py-2 rounded-lg text-xs sm:text-sm font-medium transition-colors cursor-pointer"
					>
						All Regions ({eventsWithMeta.length})
					</button>
					{availableRegions.map((region) => (
						<button
							type="button"
							data-region={region}
							aria-pressed="false"
							class="home-region-pill min-h-[44px] px-3.5 py-2 rounded-lg text-xs sm:text-sm font-medium transition-colors cursor-pointer"
						>
							{region}
						</button>
					))}
				</div>
			)
		}

		{
			eventsWithMeta.length > 0 ? (
				<ul role="list" class="flex flex-col gap-3 mt-4 list-none p-0 m-0">
					{eventsWithMeta.map(
						({
							event,
							startYmd,
							endYmd,
							lineup,
							dateParts,
							dateRange,
							statusMeta,
							admissionMeta,
						}) => (
							<li
								class="home-schedule-item"
								data-region={event.data.region}
							>
								<article class="rounded-xl border border-(--line-divider) bg-(--page-bg)/60 dark:bg-white/[0.03] p-4 flex flex-col sm:flex-row sm:items-start gap-4 min-w-0">
									<time
										datetime={event.data.startDate.toISOString()}
										class="w-16 shrink-0 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) px-2 py-2 text-center flex flex-col items-center justify-center"
									>
										<span class="text-[0.6875rem] font-bold tracking-wider uppercase leading-none">
											{dateParts.month}
										</span>
										<span class="text-xl font-bold leading-tight mt-0.5">
											{dateParts.day}
										</span>
										<span class="text-[0.6875rem] font-medium leading-none opacity-85">
											{dateParts.year}
										</span>
									</time>

									<div class="flex-1 min-w-0">
										<div class="flex flex-wrap items-center gap-2">
											<h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 leading-snug">
												<a
													href={getEventUrl(event.id)}
													class="hover:text-(--primary) transition-colors"
												>
													{event.data.title}
												</a>
											</h3>
											<span
												class={`inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium ${statusMeta.className}`}
											>
												{statusMeta.label}
											</span>
											<span
												data-countdown-start={startYmd}
												data-countdown-end={endYmd}
												class="hidden inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-sky-100 text-sky-900 border border-sky-300 dark:bg-sky-950/70 dark:text-sky-200 dark:border-sky-700/60"
											/>
										</div>

										<div class="flex flex-wrap items-center gap-2 mt-2">
											{event.data.eventType && (
												<span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-neutral-200/75 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
													{event.data.eventType}
												</span>
											)}
											<span
												class={`inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold ${admissionMeta.className}`}
											>
												{admissionMeta.label}
											</span>
										</div>

										<div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-sm text-neutral-700 dark:text-neutral-300">
											<span class="inline-flex items-center gap-1">
												<Icon
													name="material-symbols:calendar-today-outline-rounded"
													class="text-base shrink-0"
													aria-hidden="true"
												/>
												<span>
													{dateRange}
													{event.data.time ? ` (${event.data.time} ${event.data.timezone})` : ""}
												</span>
											</span>
											<span class="inline-flex items-center gap-1 min-w-0">
												<Icon
													name="material-symbols:location-on-outline-rounded"
													class="text-base shrink-0"
													aria-hidden="true"
												/>
												<span class="truncate">
													{event.data.venue}, {event.data.city}
													{event.data.region ? ` (${event.data.region})` : ""}
												</span>
											</span>
										</div>

										{lineup.length > 0 && (
											<ul
												role="list"
												aria-label={`Lineup for ${event.data.title}`}
												class="flex flex-wrap items-center gap-2 mt-3 list-none p-0 m-0"
											>
												{lineup.map((performer) => (
													<li>
														<a
															href={getPerformerUrl(performer.id)}
															class="inline-flex items-center gap-1.5 min-h-[44px] sm:min-h-[34px] px-3 py-1.5 rounded-lg text-xs font-medium bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) active:bg-(--btn-regular-bg-active) transition-colors"
														>
															<Icon
																name="material-symbols:person-rounded"
																class="text-sm shrink-0"
																aria-hidden="true"
															/>
															<span>{performer.data.name}</span>
														</a>
													</li>
												))}
											</ul>
										)}
									</div>

									{event.data.ticketUrl && (
										<div class="sm:self-center shrink-0">
											<a
												href={event.data.ticketUrl}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex items-center justify-center gap-1.5 w-full sm:w-auto min-h-[44px] px-4 py-2 rounded-lg text-sm font-semibold bg-neutral-900 text-white hover:bg-neutral-700 dark:bg-(--primary) dark:text-neutral-950 dark:hover:opacity-90 transition-colors"
											>
												<span>Tickets</span>
												<span class="sr-only"> for {event.data.title}</span>
												<Icon
													name="material-symbols:open-in-new-rounded"
													class="text-base shrink-0"
													aria-hidden="true"
												/>
											</a>
										</div>
									)}
								</article>
							</li>
						),
					)}
				</ul>
			) : (
				<div class="mt-4 rounded-xl border border-dashed border-(--line-divider) p-6 text-center">
					<p class="text-sm text-neutral-700 dark:text-neutral-300">
						No upcoming events are scheduled yet. Browse past appearances in the{" "}
						<a href={url("/wiki/events/")} class="text-(--primary) font-medium hover:underline">
							event archive
						</a>
						.
					</p>
				</div>
			)
		}

		<div class="home-schedule-filtered-empty hidden mt-4 rounded-xl border border-dashed border-(--line-divider) p-6 text-center">
			<p class="text-sm text-neutral-700 dark:text-neutral-300">
				No upcoming events match this region right now.
			</p>
			<button
				type="button"
				data-reset-home-region
				class="mt-3 min-h-[44px] px-4 py-2 rounded-lg text-sm font-medium bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) cursor-pointer transition-colors"
			>
				Show all regions
			</button>
		</div>
	</home-schedule-filter>
</section>

<script is:inline>
	(function () {
		function parseUtcDayMs(ymd) {
			var parts = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymd || "");
			if (!parts) return NaN;
			return Date.UTC(Number(parts[1]), Number(parts[2]) - 1, Number(parts[3]));
		}

		function getJakartaTodayYmd() {
			try {
				return new Intl.DateTimeFormat("en-CA", {
					timeZone: "Asia/Jakarta",
				}).format(new Date());
			} catch {
				return new Date().toISOString().slice(0, 10);
			}
		}

		function updateCountdowns() {
			var todayYmd = getJakartaTodayYmd();
			var todayMs = parseUtcDayMs(todayYmd);
			var todayDow = new Date(todayMs).getUTCDay();
			var nodes = document.querySelectorAll("[data-countdown-start]");

			nodes.forEach(function (el) {
				var startYmd = el.getAttribute("data-countdown-start") || "";
				var endYmd = el.getAttribute("data-countdown-end") || startYmd;
				var startMs = parseUtcDayMs(startYmd);
				var endMs = parseUtcDayMs(endYmd);
				if (Number.isNaN(startMs) || Number.isNaN(endMs)) return;

				var diffStart = Math.round((startMs - todayMs) / 86400000);
				var diffEnd = Math.round((endMs - todayMs) / 86400000);
				var label = "";

				if (diffEnd < 0) {
					label = "Ended";
				} else if (diffStart <= 0 && diffEnd >= 0) {
					label = startYmd === endYmd ? "Today" : "Ongoing";
				} else if (diffStart === 1) {
					label = "Tomorrow";
				} else if (diffStart <= 6) {
					var startDow = new Date(startMs).getUTCDay();
					var daysUntilSat = (6 - todayDow + 7) % 7;
					if (
						(startDow === 0 || startDow === 6) &&
						diffStart <= daysUntilSat + 1
					) {
						label = "This Weekend";
					} else {
						label = "In " + diffStart + " days";
					}
				} else if (diffStart <= 30) {
					label = "In " + diffStart + " days";
				}

				if (label) {
					el.textContent = label;
					el.classList.remove("hidden");
				} else {
					el.classList.add("hidden");
				}
			});
		}

		if (!customElements.get("home-schedule-filter")) {
			class HomeScheduleFilter extends HTMLElement {
				selectedRegion = "all";
				connectedCallback() {
					this.addEventListener("click", this.handleClick);
					updateCountdowns();
				}
				disconnectedCallback() {
					this.removeEventListener("click", this.handleClick);
				}
				handleClick(e) {
					var resetBtn = e.target.closest("[data-reset-home-region]");
					if (resetBtn) {
						this.selectedRegion = "all";
						this.syncButtons();
						this.applyFilter();
						return;
					}
					var pill = e.target.closest("button[data-region]");
					if (!pill) return;
					this.selectedRegion = pill.getAttribute("data-region") || "all";
					this.syncButtons();
					this.applyFilter();
				}
				syncButtons() {
					var self = this;
					this.querySelectorAll("button[data-region]").forEach(function (btn) {
						var active = btn.getAttribute("data-region") === self.selectedRegion;
						btn.toggleAttribute("data-active", active);
						btn.setAttribute("aria-pressed", String(active));
					});
				}
				applyFilter() {
					var items = this.querySelectorAll(".home-schedule-item");
					var visibleCount = 0;
					var self = this;
					items.forEach(function (item) {
						var match =
							self.selectedRegion === "all" ||
							item.getAttribute("data-region") === self.selectedRegion;
						item.style.display = match ? "" : "none";
						if (match) visibleCount += 1;
					});
					var empty = this.querySelector(".home-schedule-filtered-empty");
					if (empty) {
						empty.classList.toggle("hidden", visibleCount > 0 || items.length === 0);
					}
				}
			}
			customElements.define("home-schedule-filter", HomeScheduleFilter);
		}

		if (!window.__homeScheduleCountdownBound) {
			window.__homeScheduleCountdownBound = true;
			document.addEventListener("DOMContentLoaded", updateCountdowns);
			document.addEventListener("astro:page-load", updateCountdowns);
		}
		updateCountdowns();
	})();
</script>

<style>
	.home-region-pill {
		background: var(--btn-regular-bg);
		color: var(--btn-content);
	}
	.home-region-pill:hover {
		background: var(--btn-regular-bg-hover);
	}
	.home-region-pill[data-active] {
		background: var(--primary);
		color: #fff;
	}
	:global(:root.dark) .home-region-pill[data-active] {
		color: rgb(0 0 0 / 85%);
	}
</style>
