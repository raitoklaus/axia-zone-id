---
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getEventUrl, getPerformerUrl, url } from "@/utils/url-utils";
import {
	formatEventDateRange,
	getAdmissionMeta,
	getEventCalendarParts,
	getEventCategoryTone,
	getEventStatusMeta,
	getUpcomingEvents,
	resolveEventLineup,
} from "@/utils/wiki-utils";

const upcomingEvents = await getUpcomingEvents(6);
const eventsWithMeta = await Promise.all(
	upcomingEvents.map(async (event) => {
		const startYmd = formatDateToYYYYMMDD(event.data.startDate);
		const endYmd = event.data.endDate
			? formatDateToYYYYMMDD(event.data.endDate)
			: startYmd;
		return {
			event,
			startYmd,
			endYmd,
			displayDotDate: startYmd.replaceAll("-", "."),
			categoryTone: getEventCategoryTone(event.data.eventType),
			lineup: await resolveEventLineup(event),
			dateParts: getEventCalendarParts(event.data.startDate),
			dateRange: formatEventDateRange(event.data.startDate, event.data.endDate),
			statusMeta: getEventStatusMeta(event.data.status),
			admissionMeta: getAdmissionMeta(event.data.entryType, event.data.htm),
		};
	}),
);

const availableRegions = Array.from(
	new Set(
		eventsWithMeta
			.map(({ event }) => event.data.region.trim())
			.filter((region) => region.length > 0),
	),
);
---

<section
	aria-labelledby="upcoming-schedule-heading"
	class="axia-open-section mb-12 onload-animation"
>
	<home-schedule-filter class="block">
		<div class="axia-sekai-heading">
			<span class="axia-sekai-watermark" aria-hidden="true">
				SCHEDULE &nbsp; SCHEDULE &nbsp; SCHEDULE
			</span>
			<h2 id="upcoming-schedule-heading" class="axia-sekai-title">
				Upcoming Schedule
			</h2>
			<div class="axia-sekai-rule" aria-hidden="true"></div>
			<p class="axia-sekai-subtitle">
				Indonesian ACG conventions, mall matsuri, anisong lives, and connected performer lineups
			</p>
		</div>

		{
			availableRegions.length > 1 && (
				<div
					class="flex flex-wrap items-center justify-center gap-2 mb-6"
					role="group"
					aria-label="Filter upcoming schedule by region"
				>
					<button
						type="button"
						data-region="all"
						data-active
						aria-pressed="true"
						class="home-region-pill min-h-[44px] px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-colors cursor-pointer"
					>
						All Regions ({eventsWithMeta.length})
					</button>
					{availableRegions.map((region) => (
						<button
							type="button"
							data-region={region}
							aria-pressed="false"
							class="home-region-pill min-h-[44px] px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-colors cursor-pointer"
						>
							{region}
						</button>
					))}
				</div>
			)
		}

		{
			eventsWithMeta.length > 0 ? (
				<ul role="list" class="axia-schedule-grid list-none p-0 m-0">
					{eventsWithMeta.map(
						({
							event,
							startYmd,
							endYmd,
							displayDotDate,
							categoryTone,
							lineup,
							dateParts,
							dateRange,
							statusMeta,
							admissionMeta,
						}) => (
							<li
								class="home-schedule-item flex"
								data-region={event.data.region}
							>
								<article class="axia-sekai-card flex flex-col w-full min-w-0">
									<div class="axia-split-bar">
										<time
											datetime={event.data.startDate.toISOString()}
											class="axia-split-date"
										>
											<span>{displayDotDate}</span>
										</time>
										<div class="axia-split-type" data-cat-tone={categoryTone}>
											<span class="truncate">
												{event.data.eventType || "ACG Event"}
											</span>
											<span class="shrink-0 opacity-95">
												{statusMeta.label}
											</span>
										</div>
									</div>

									<a
										href={getEventUrl(event.id)}
										aria-hidden="true"
										tabindex="-1"
										class:list={[
											"axia-event-stage block group",
											event.data.image ? "has-poster" : "is-editorial",
										]}
										data-cat-tone={categoryTone}
									>
										{event.data.image ? (
											<img
												src={
													event.data.image.startsWith("/")
														? url(event.data.image)
														: event.data.image
												}
												alt=""
												loading="lazy"
												decoding="async"
												class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
											/>
										) : (
											<div class="h-full w-full p-4 flex flex-col justify-between gap-3 relative overflow-hidden">
												<span
													aria-hidden="true"
													class="pointer-events-none select-none absolute -right-2 -bottom-3 text-5xl font-extrabold uppercase tracking-wider text-[#2f3550]/[0.06] dark:text-white/[0.06]"
													style="font-family: var(--font-montserrat, sans-serif)"
												>
													{event.data.city}
												</span>

												<div class="flex items-start justify-between gap-2 relative z-10">
													<span class="inline-flex items-center px-2.5 py-1 rounded text-[0.7rem] font-bold uppercase tracking-wider bg-[#2f3550] text-white">
														{event.data.region || event.data.city}
													</span>
													<span
														data-countdown-start={startYmd}
														data-countdown-end={endYmd}
														class="hidden items-center px-2.5 py-1 rounded text-[0.7rem] font-bold bg-white/95 text-[#2b314a] border border-black/10 dark:bg-[#14192b] dark:text-[#e2e8f0] dark:border-white/15"
													/>
												</div>

												<div class="flex items-end justify-between gap-2 relative z-10">
													<div class="flex items-baseline gap-1.5 shrink-0 whitespace-nowrap" style="font-family: var(--font-montserrat, sans-serif)">
														<span class="text-3xl font-extrabold leading-none text-[#2b314a] dark:text-white">
															{dateParts.day}
														</span>
														<span class="text-xs font-extrabold tracking-widest uppercase text-[#0c6fc4] dark:text-[#7ee8ff]">
															{dateParts.month} {dateParts.year}
														</span>
													</div>
													<span
														class={`inline-flex items-center px-2.5 py-1 rounded text-[0.68rem] leading-tight text-right font-bold max-w-[58%] ${admissionMeta.className}`}
													>
														{admissionMeta.label}
													</span>
												</div>
											</div>
										)}
									</a>

									<div class="p-5 flex-1 flex flex-col min-w-0">
										<h3 class="text-lg font-bold text-[#2b314a] dark:text-slate-100 leading-snug line-clamp-2">
											<a
												href={getEventUrl(event.id)}
												class="hover:text-[#0c6fc4] dark:hover:text-[#7ee8ff] transition-colors"
											>
												{event.data.title}
											</a>
										</h3>

										<div class="flex flex-col gap-1 mt-2.5 text-sm text-[#4b526e] dark:text-slate-300">
											<span class="inline-flex items-center gap-1.5">
												<Icon
													name="material-symbols:calendar-today-outline-rounded"
													class="text-base shrink-0 text-[#0c6fc4] dark:text-[#5ce1ff]"
													aria-hidden="true"
												/>
												<span class="truncate">
													{dateRange}
													{event.data.time ? ` (${event.data.time} ${event.data.timezone})` : ""}
												</span>
											</span>
											<span class="inline-flex items-center gap-1.5 min-w-0">
												<Icon
													name="material-symbols:location-on-outline-rounded"
													class="text-base shrink-0 text-[#0c6fc4] dark:text-[#5ce1ff]"
													aria-hidden="true"
												/>
												<span class="truncate">
													{event.data.venue}, {event.data.city}
												</span>
											</span>
										</div>

										{lineup.length > 0 && (
											<ul
												role="list"
												aria-label={`Lineup for ${event.data.title}`}
												class="flex flex-wrap items-center gap-1.5 mt-3 list-none p-0 m-0"
											>
												{lineup.map((performer) => (
													<li>
														<a
															href={getPerformerUrl(performer.id)}
															class="inline-flex items-center gap-1 min-h-[44px] sm:min-h-[34px] px-2.5 py-1 rounded-full text-xs font-medium bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) transition-colors"
														>
															<Icon
																name="material-symbols:person-rounded"
																class="text-sm shrink-0"
																aria-hidden="true"
															/>
															<span>{performer.data.name}</span>
														</a>
													</li>
												))}
											</ul>
										)}

										<div class="mt-auto pt-4 mt-4 border-t border-black/8 dark:border-white/10 flex items-center justify-between gap-2">
											<a
												href={getEventUrl(event.id)}
												class="inline-flex items-center gap-1 min-h-[44px] sm:min-h-[36px] text-xs font-bold uppercase tracking-wider text-[#0c6fc4] dark:text-[#7ee8ff] hover:underline"
												style="font-family: var(--font-montserrat, sans-serif)"
											>
												<span>Details</span>
												<Icon name="material-symbols:chevron-right-rounded" class="text-base" aria-hidden="true" />
											</a>

											{event.data.ticketUrl && (
												<a
													href={event.data.ticketUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="axia-pill-cta axia-pill-cta-primary"
												>
													<span>Tickets</span>
													<span class="sr-only"> for {event.data.title}</span>
													<Icon
														name="material-symbols:open-in-new-rounded"
														class="text-sm shrink-0"
														aria-hidden="true"
													/>
												</a>
											)}
										</div>
									</div>
								</article>
							</li>
						),
					)}
				</ul>
			) : (
				<div class="axia-sekai-card p-8 text-center">
					<p class="text-sm text-[#4b526e] dark:text-slate-300">
						No upcoming events are scheduled yet. Browse past appearances in the{" "}
						<a href={url("/wiki/events/")} class="text-[#0c6fc4] dark:text-[#7ee8ff] font-semibold hover:underline">
							event archive
						</a>
						.
					</p>
				</div>
			)
		}

		<div class="home-schedule-filtered-empty hidden axia-sekai-card p-8 text-center mt-4">
			<p class="text-sm text-[#4b526e] dark:text-slate-300">
				No upcoming events match this region right now.
			</p>
			<button
				type="button"
				data-reset-home-region
				class="mt-3 min-h-[44px] px-4 py-2 rounded-full text-sm font-semibold bg-[#2f3550] text-white hover:bg-[#0c6fc4] cursor-pointer transition-colors"
			>
				Show all regions
			</button>
		</div>

		<nav aria-label="Full schedule and performer wiki" class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<a
				href={url("/wiki/events/")}
				class="axia-stage-btn axia-stage-btn-cyan min-w-[230px]"
			>
				<span>All Events &amp; Calendar</span>
			</a>
			<a
				href={url("/wiki/performers/")}
				class="axia-stage-btn axia-stage-btn-outline"
			>
				<span>Performer Wiki</span>
			</a>
		</nav>
	</home-schedule-filter>
</section>

<script is:inline>
	(function () {
		function parseUtcDayMs(ymd) {
			var parts = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymd || "");
			if (!parts) return NaN;
			return Date.UTC(Number(parts[1]), Number(parts[2]) - 1, Number(parts[3]));
		}

		function getJakartaTodayYmd() {
			try {
				return new Intl.DateTimeFormat("en-CA", {
					timeZone: "Asia/Jakarta",
				}).format(new Date());
			} catch {
				return new Date().toISOString().slice(0, 10);
			}
		}

		function updateCountdowns() {
			var todayYmd = getJakartaTodayYmd();
			var todayMs = parseUtcDayMs(todayYmd);
			var todayDow = new Date(todayMs).getUTCDay();
			var nodes = document.querySelectorAll("[data-countdown-start]");

			nodes.forEach(function (el) {
				var startYmd = el.getAttribute("data-countdown-start") || "";
				var endYmd = el.getAttribute("data-countdown-end") || startYmd;
				var startMs = parseUtcDayMs(startYmd);
				var endMs = parseUtcDayMs(endYmd);
				if (Number.isNaN(startMs) || Number.isNaN(endMs)) return;

				var diffStart = Math.round((startMs - todayMs) / 86400000);
				var diffEnd = Math.round((endMs - todayMs) / 86400000);
				var label = "";

				if (diffEnd < 0) {
					label = "Ended";
				} else if (diffStart <= 0 && diffEnd >= 0) {
					label = startYmd === endYmd ? "Today" : "Ongoing";
				} else if (diffStart === 1) {
					label = "Tomorrow";
				} else if (diffStart <= 6) {
					var startDow = new Date(startMs).getUTCDay();
					var daysUntilSat = (6 - todayDow + 7) % 7;
					if (
						(startDow === 0 || startDow === 6) &&
						diffStart <= daysUntilSat + 1
					) {
						label = "This Weekend";
					} else {
						label = "In " + diffStart + " days";
					}
				} else if (diffStart <= 30) {
					label = "In " + diffStart + " days";
				}

				if (label) {
					el.textContent = label;
					el.classList.remove("hidden");
					el.classList.add("inline-flex");
				} else {
					el.textContent = "";
					el.classList.add("hidden");
					el.classList.remove("inline-flex");
				}
			});
		}

		if (!customElements.get("home-schedule-filter")) {
			class HomeScheduleFilter extends HTMLElement {
				selectedRegion = "all";
				connectedCallback() {
					this.addEventListener("click", this.handleClick);
					updateCountdowns();
				}
				disconnectedCallback() {
					this.removeEventListener("click", this.handleClick);
				}
				handleClick(e) {
					var resetBtn = e.target.closest("[data-reset-home-region]");
					if (resetBtn) {
						this.selectedRegion = "all";
						this.syncButtons();
						this.applyFilter();
						return;
					}
					var pill = e.target.closest("button[data-region]");
					if (!pill) return;
					this.selectedRegion = pill.getAttribute("data-region") || "all";
					this.syncButtons();
					this.applyFilter();
				}
				syncButtons() {
					var self = this;
					this.querySelectorAll("button[data-region]").forEach(function (btn) {
						var active = btn.getAttribute("data-region") === self.selectedRegion;
						btn.toggleAttribute("data-active", active);
						btn.setAttribute("aria-pressed", String(active));
					});
				}
				applyFilter() {
					var items = this.querySelectorAll(".home-schedule-item");
					var visibleCount = 0;
					var self = this;
					items.forEach(function (item) {
						var match =
							self.selectedRegion === "all" ||
							item.getAttribute("data-region") === self.selectedRegion;
						item.style.display = match ? "" : "none";
						if (match) visibleCount += 1;
					});
					var empty = this.querySelector(".home-schedule-filtered-empty");
					if (empty) {
						empty.classList.toggle("hidden", visibleCount > 0 || items.length === 0);
					}
				}
			}
			customElements.define("home-schedule-filter", HomeScheduleFilter);
		}

		if (!window.__homeScheduleCountdownBound) {
			window.__homeScheduleCountdownBound = true;
			document.addEventListener("DOMContentLoaded", updateCountdowns);
			document.addEventListener("astro:page-load", updateCountdowns);
		}
		updateCountdowns();
	})();
</script>

<style>
	.axia-schedule-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 310px), 1fr));
		gap: 1.5rem;
	}

	.home-region-pill {
		background: #ffffff;
		color: #2b314a;
		border: 1px solid rgba(47, 53, 80, 0.14);
		box-shadow: 0 3px 10px -4px rgba(47, 53, 80, 0.10);
	}
	.home-region-pill:hover {
		border-color: #0c6fc4;
		color: #0c6fc4;
	}
	.home-region-pill[data-active] {
		background: #2f3550;
		color: #ffffff;
		border-color: #2f3550;
	}

	:global(:root.dark) .home-region-pill {
		background: #1c2236;
		color: #e2e8f0;
		border-color: rgba(255, 255, 255, 0.14);
	}
	:global(:root.dark) .home-region-pill:hover {
		border-color: #5ce1ff;
		color: #7ee8ff;
	}
	:global(:root.dark) .home-region-pill[data-active] {
		background: #0c6fc4;
		color: #ffffff;
		border-color: #38bdf8;
	}
</style>
