---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";

export interface InfoboxRow {
	label: string;
	value: string;
}

export interface InfoboxLink {
	label: string;
	url: string;
	icon?: string;
}

interface Props {
	title: string;
	category: string;
	tone?: "live" | "matsuri" | "anikura" | "expo" | "blog";
	subtitle?: string;
	image?: string;
	initials?: string;
	rows: InfoboxRow[];
	links?: InfoboxLink[];
}

const {
	title,
	category,
	tone = "blog",
	subtitle = "",
	image = "",
	initials = "",
	rows = [],
	links = [],
} = Astro.props;

const filteredRows = rows.filter(
	(row) => row.label.trim().length > 0 && row.value.trim().length > 0,
);
---

<aside
	aria-label={`${title} infobox`}
	class="axia-sekai-card w-full md:w-72 lg:w-76 shrink-0 flex flex-col overflow-hidden"
>
	<div class="axia-split-bar">
		<span class="axia-split-date">Infobox</span>
		<span class="axia-split-type" data-cat-tone={tone}>
			<span class="truncate">{category}</span>
		</span>
	</div>

	<div class="p-4 flex flex-col gap-3">
		{
			(image || initials) && (
				<div class="flex items-center gap-3">
					{image ? (
						<ImageWrapper
							src={image}
							alt={title}
							width={72}
							height={72}
							loading="eager"
							usePicture={false}
							fadeIn={false}
							showLqip={false}
							showOverlay={false}
							class="w-16 h-16 rounded-lg overflow-hidden shrink-0 bg-(--btn-regular-bg) border border-(--line-divider)"
						/>
					) : (
						<div
							aria-hidden="true"
							class="w-16 h-16 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) flex items-center justify-center text-lg font-extrabold shrink-0 border border-(--line-divider)"
							style="font-family: var(--font-montserrat, sans-serif)"
						>
							{initials}
						</div>
					)}
					<div class="min-w-0">
						<div
							class="font-bold text-base text-[#2b314a] dark:text-slate-100 leading-snug"
							style="font-family: var(--font-montserrat, sans-serif)"
						>
							{title}
						</div>
						{subtitle && (
							<div class="text-xs font-semibold text-(--primary) mt-0.5 leading-snug">
								{subtitle}
							</div>
						)}
					</div>
				</div>
			)
		}

		{
			!image && !initials && (
				<div class="border-b border-(--line-divider) pb-2.5">
					<div
						class="font-bold text-base text-[#2b314a] dark:text-slate-100 leading-snug"
						style="font-family: var(--font-montserrat, sans-serif)"
					>
						{title}
					</div>
					{subtitle && (
						<div class="text-xs font-semibold text-(--primary) mt-0.5 leading-snug">
							{subtitle}
						</div>
					)}
				</div>
			)
		}

		{
			filteredRows.length > 0 && (
				<dl class="grid grid-cols-1 divide-y divide-(--line-divider) text-xs border-t border-(--line-divider) pt-1">
					{filteredRows.map((row) => (
						<div class="py-2 flex items-start justify-between gap-3">
							<dt class="font-bold uppercase tracking-wider text-[#4a5170] dark:text-slate-400 shrink-0">
								{row.label}
							</dt>
							<dd class="text-right font-medium text-[#2b314a] dark:text-slate-200 break-words min-w-0">
								{row.value}
							</dd>
						</div>
					))}
				</dl>
			)
		}

		{
			links.length > 0 && (
				<div class="pt-2 border-t border-(--line-divider) flex flex-wrap gap-1.5">
					{links.map((link) => (
						<a
							href={link.url}
							target={link.url.startsWith("http") ? "_blank" : undefined}
							rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}
							class="inline-flex items-center gap-1.5 min-h-[44px] sm:min-h-[34px] px-2.5 py-1 rounded-lg text-xs font-semibold bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) transition-colors"
						>
							{link.icon && (
								<Icon name={link.icon} class="text-sm shrink-0" aria-hidden="true" />
							)}
							<span>{link.label}</span>
						</a>
					))}
				</div>
			)
		}
	</div>
</aside>
