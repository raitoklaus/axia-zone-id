---
import { Icon } from "astro-icon/components";
import { getPerformerUrl, getWikiUrl, url } from "@/utils/url-utils";
import {
	getAllPerformers,
	getAllWikiEntries,
	getPerformerInitials,
	getWikiCategoryTone,
} from "@/utils/wiki-utils";

const [wikiEntries, performers] = await Promise.all([
	getAllWikiEntries(),
	getAllPerformers(),
]);

const spotlightWiki = [...wikiEntries]
	.sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
	.slice(0, 3);

const spotlightPerformers = performers.slice(0, 6);
---

{
	(spotlightWiki.length > 0 || spotlightPerformers.length > 0) && (
		<section
			aria-labelledby="home-wiki-spotlight-heading"
			class="card-base p-4 sm:p-5 md:p-6 mb-4 relative overflow-hidden onload-animation"
		>
			<div class="axia-panel-header flex flex-wrap items-start justify-between gap-3 pb-3.5 mb-4 border-b border-(--line-divider)">
				<span class="axia-panel-watermark" aria-hidden="true">WIKI</span>
				<div class="relative z-10 min-w-0">
					<div class="flex items-center gap-2.5">
						<span class="axia-prism-bar" aria-hidden="true"></span>
						<h2
							id="home-wiki-spotlight-heading"
							class="text-lg md:text-xl font-extrabold uppercase tracking-wide text-[#2b314a] dark:text-slate-100"
							style="font-family: var(--font-montserrat, sans-serif)"
						>
							Axia ACG Wiki
						</h2>
					</div>
					<p class="text-xs sm:text-sm text-[#4a5170] dark:text-slate-300 mt-1">
						Lore Axia, profil komunitas lokal, seri matsuri, dan direktori performer Bandung &amp; Indonesia
					</p>
				</div>
				<div class="relative z-10 shrink-0 hidden sm:flex items-center gap-2">
					<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-(--btn-regular-bg) text-(--btn-content)">
						<Icon name="material-symbols:menu-book-rounded" class="text-sm" aria-hidden="true" />
						<span>{wikiEntries.length} Articles · {performers.length} Performers</span>
					</span>
				</div>
			</div>

			{spotlightWiki.length > 0 && (
				<ul
					role="list"
					class="grid gap-3 list-none p-0 m-0"
					style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));"
				>
					{spotlightWiki.map((entry) => {
						const tone = getWikiCategoryTone(entry.data.category);
						return (
							<li class="flex">
								<article class="axia-sekai-card flex flex-col w-full min-w-0">
									<div class="axia-split-bar">
										<span class="axia-split-date">{entry.data.city || "Wiki"}</span>
										<span class="axia-split-type" data-cat-tone={tone}>
											<span class="truncate">{entry.data.category}</span>
										</span>
									</div>
									<div class="p-4 flex-1 flex flex-col gap-2">
										<h3 class="text-base font-bold text-[#2b314a] dark:text-slate-100 leading-snug line-clamp-2">
											<a
												href={getWikiUrl(entry.id)}
												class="hover:text-[#0c6fc4] dark:hover:text-[#7ee8ff] transition-colors"
											>
												{entry.data.title}
											</a>
										</h3>
										{entry.data.summary && (
											<p class="text-xs sm:text-sm text-[#4a5170] dark:text-slate-300 line-clamp-2 leading-relaxed">
												{entry.data.summary}
											</p>
										)}
										<div class="mt-auto pt-2.5 border-t border-black/8 dark:border-white/10 flex items-center justify-between gap-2 text-xs">
											<span class="text-[#4a5170] dark:text-slate-300 truncate">
												{entry.data.status || "Active"}
											</span>
											<a
												href={getWikiUrl(entry.id)}
												class="inline-flex items-center gap-0.5 font-bold uppercase tracking-wider text-[#0c6fc4] dark:text-[#7ee8ff] hover:underline shrink-0"
												style="font-family: var(--font-montserrat, sans-serif)"
											>
												<span>Read</span>
												<Icon name="material-symbols:chevron-right-rounded" class="text-base" aria-hidden="true" />
											</a>
										</div>
									</div>
								</article>
							</li>
						);
					})}
				</ul>
			)}

			{spotlightPerformers.length > 0 && (
				<div class="mt-4 pt-3.5 border-t border-(--line-divider)">
					<div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
						<h3
							class="text-xs font-extrabold uppercase tracking-wider text-[#4a5170] dark:text-slate-300"
							style="font-family: var(--font-montserrat, sans-serif)"
						>
							Performer Spotlight
						</h3>
						<a
							href={url("/wiki/performers/")}
							class="inline-flex items-center gap-0.5 text-xs font-bold text-[#0c6fc4] dark:text-[#7ee8ff] hover:underline"
						>
							<span>Browse All Performers ({performers.length})</span>
							<Icon name="material-symbols:chevron-right-rounded" class="text-sm" aria-hidden="true" />
						</a>
					</div>

					<ul
						role="list"
						class="grid gap-2.5 list-none p-0 m-0"
						style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));"
					>
						{spotlightPerformers.map((performer) => (
							<li>
								<a
									href={getPerformerUrl(performer.id)}
									class="flex items-center gap-2.5 p-2.5 rounded-xl border border-(--line-divider) bg-(--page-bg)/60 dark:bg-white/[0.03] hover:border-(--primary) transition-colors"
								>
									<div
										aria-hidden="true"
										class="w-9 h-9 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) flex items-center justify-center text-xs font-extrabold shrink-0"
										style="font-family: var(--font-montserrat, sans-serif)"
									>
										{getPerformerInitials(performer.data.name)}
									</div>
									<div class="min-w-0">
										<div class="font-bold text-xs sm:text-sm text-[#2b314a] dark:text-slate-100 truncate">
											{performer.data.name}
										</div>
										<div class="text-[0.7rem] text-[#4a5170] dark:text-slate-300 truncate">
											{performer.data.category || performer.data.role}
										</div>
									</div>
								</a>
							</li>
						))}
					</ul>
				</div>
			)}

			<nav aria-label="Wiki navigation shortcuts" class="mt-4 flex flex-wrap items-center justify-center sm:justify-end gap-2.5">
				<a href={url("/wiki/performers/")} class="axia-stage-btn axia-stage-btn-outline">
					<span>Performers Directory</span>
				</a>
				<a href={url("/wiki/")} class="axia-stage-btn axia-stage-btn-cyan">
					<span>Open Wiki Hub</span>
				</a>
			</nav>
		</section>
	)
}
