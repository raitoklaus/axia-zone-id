---
// Fullscreen chibi Axia loading screen modeled after pjsekai.sega.jp.
// Uses compositor-only CSS transforms + opacity (no runtime JS animation library).
---

<div
	id="axia-loading-screen"
	class="axia-loader"
	role="status"
	aria-live="polite"
	data-swup-ignore
>
	<span class="sr-only">Loading Axia Zone ID</span>

	<div class="axia-loader-icon" aria-hidden="true">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 240 268"
			width="240"
			height="268"
			preserveAspectRatio="xMidYMid meet"
			class="axia-loader-svg"
		>
			<defs>
				<linearGradient id="axia-hair-grad" x1="0" y1="1" x2="0" y2="0">
					<stop offset="0%" stop-color="#593834" />
					<stop offset="55%" stop-color="#6e4943" />
					<stop offset="100%" stop-color="#875d55" />
				</linearGradient>

				<path
					id="axia-bob-shape"
					d="M115 20
					C72 20 43 44 31 86
					C23 116 21 154 23 178
					C25 191 31 200 39 203
					C42 204 45 201 47 198
					C49 203 52 206.5 55 206.5
					C58 206.5 60 201 61 195
					C74 201 90 203.5 106 203
					C122 202.5 137 199 147 194
					C147 200 147.5 206.5 149.5 206.5
					C151.5 206.5 153 203 154 200
					C155.5 204 157 206.5 159 206.5
					C161.5 206.5 164 201 165.5 196
					C167.5 200.5 170 203.5 172.5 203
					C175 202.5 177 199.5 178 197.5
					C181 201.5 186 203.5 191 202
					C194 201 196 199.5 197.5 201
					C201 203 206 201 210 194
					C216 183 218 160 218 134
					C218 96 208 60 185 40
					C165 24 142 20 115 20 Z"
				/>

				<path
					id="axia-face-shape"
					d="M57 118
					C56 134 53.5 148 53.5 164
					C53.5 178 56 188 61 195
					C74 201 90 203.5 106 203
					C122 202.5 137 199 147 194
					C149 178 149.5 162 148.5 146
					C146 126 137 102 126 79
					C122 98 119 118 117 134
					Q112 138 106 131
					Q100 138 92 138
					Q86 138 83 133
					Q78 139 71 134
					Q65 138 60 131
					Z"
				/>

				<!-- Hair interior mask: white inside bob hair, black inside face plate -->
				<mask id="axia-hair-mask">
					<use href="#axia-bob-shape" fill="#ffffff" />
					<use href="#axia-face-shape" fill="#000000" />
				</mask>

				<clipPath id="axia-face-clip">
					<use href="#axia-face-shape" />
				</clipPath>
			</defs>

			<!-- Layer 1: White outer sticker halo -->
			<use
				href="#axia-bob-shape"
				fill="#ffffff"
				stroke="#ffffff"
				stroke-width="18"
				stroke-linejoin="round"
				stroke-linecap="round"
			/>

			<!-- Layer 2: Soft warm-white chibi base fill -->
			<use href="#axia-bob-shape" fill="#fbf5f3" />

			<!-- Layer 3: Rising Axia chestnut-brown hair gradient inside hair silhouette -->
			<g mask="url(#axia-hair-mask)">
				<rect
					class="axia-fill-rect"
					x="18"
					y="18"
					width="204"
					height="192"
					fill="url(#axia-hair-grad)"
				/>
			</g>

			<!-- Layer 4: Clean face plate + soft blush cheeks -->
			<use href="#axia-face-shape" fill="#fff9f8" />
			<g clip-path="url(#axia-face-clip)">
				<ellipse cx="63" cy="178" rx="13" ry="11" fill="#ffd8dc" opacity="0.78" />
				<ellipse cx="137" cy="179" rx="13" ry="11" fill="#ffd8dc" opacity="0.78" />
			</g>

			<!-- Layer 5: Chibi Axia line-art, bangs, hair clips, eyes, and smug smile -->
			<g
				fill="none"
				stroke="#2a1b2e"
				stroke-width="3.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<!-- Outer bob & chin contour -->
				<use href="#axia-bob-shape" fill="none" />

				<!-- Inner hair-to-face boundary, bangs, and tall right inverted-V parting -->
				<path
					d="M57 118
					C56 134 53.5 148 53.5 164
					C53.5 178 56 188 61 195"
				/>
				<path
					d="M60 131
					Q65 138 71 134
					Q78 139 83 133
					Q86 138 92 138
					Q100 138 106 131
					Q112 138 117 134
					C119 118 122 98 126 79
					C137 102 146 126 148.5 146
					C149.5 162 149 178 147 194"
				/>

				<!-- Bang lock separation strokes & slender parting lock -->
				<path d="M71 134 C71.5 120 72 104 72 92" stroke-width="2.1" />
				<path d="M83 133 C84 118 85 102 86 88" stroke-width="2.1" />
				<path d="M106 131 C108 118 110 106 112 94" stroke-width="2.1" />
				<path d="M137 110 C142 126 144 138 144 146" stroke-width="2.1" />

				<!-- Interior hair flow lines -->
				<path d="M105 28 C82 34 65 49 56 72" stroke-width="2.1" />
				<path d="M126 30 C145 40 156 56 164 78" stroke-width="2.1" />
				<path d="M37 124 C32 152 34 178 44 196" stroke-width="2.1" />
				<path d="M49 166 C48 182 50 194 54 203" stroke-width="2.1" />
				<path d="M164 82 C175 118 176 160 165 196" stroke-width="2.1" />
				<path d="M189 96 C198 134 197 168 184 198" stroke-width="2.1" />
				<path d="M205 132 C209 158 206 180 197 199" stroke-width="2.1" />
				<path d="M215 126 C221 146 220 168 215 182" stroke-width="1.8" />

				<!-- Forehead specular dashes matching Axia's bangs highlights -->
				<rect x="73" y="73" width="3.2" height="8.5" rx="1.6" fill="#87a4c4" stroke="none" />
				<rect x="78.8" y="74.5" width="3" height="6.2" rx="1.5" fill="#87a4c4" stroke="none" />
				<circle cx="87.5" cy="78.3" r="1.6" fill="#87a4c4" stroke="none" />
				<rect x="99.5" y="77.8" width="5.2" height="2.6" rx="1.3" fill="#87a4c4" stroke="none" />
				<circle cx="108.2" cy="78.8" r="1.5" fill="#87a4c4" stroke="none" />

				<!-- Twin diagonal sky-blue hair clips (viewer left) -->
				<rect
					x="37"
					y="103.2"
					width="22"
					height="5.6"
					rx="2.8"
					transform="rotate(21 48 106)"
					fill="#4fd2ff"
					stroke="#2a1b2e"
					stroke-width="2.6"
				/>
				<rect
					x="37"
					y="115.7"
					width="21"
					height="5.6"
					rx="2.8"
					transform="rotate(17 47.5 118.5)"
					fill="#4fd2ff"
					stroke="#2a1b2e"
					stroke-width="2.6"
				/>

				<!-- Confident angled brows & right upper-eyelid crease -->
				<path d="M61 119 Q74 125 87 127" stroke-width="2.3" />
				<path d="M142 114 Q129 123 113 127" stroke-width="2.3" />
				<path d="M118 134 L132 134" stroke="#5d3b44" stroke-width="1.8" />

				<!-- Open half-lidded jitome Y-gleam eyes (fades out during blink) -->
				<g class="axia-eyes-open">
					<!-- Left eye -->
					<g>
						<path
							d="M62.5 144.5 L80.7 144.5 L80.7 154 C80.7 161 76.8 164.5 71.6 164.5 C66.4 164.5 62.5 161 62.5 154 Z"
							fill="#1567d8"
							stroke="#2a1b2e"
							stroke-width="2.8"
						/>
						<path
							d="M64.2 154.5 C64.8 160.2 68 162.8 71.6 162.8 C75.2 162.8 78.4 160.2 79 154.5 C76.6 156.6 74.2 157.5 71.6 157.5 C69 157.5 66.6 156.6 64.2 154.5 Z"
							fill="#39ceff"
							stroke="none"
						/>
						<path
							d="M66.2 148.5 L71.6 153 L77 148.5 M71.6 153 L71.6 161.2"
							stroke="#edfaff"
							stroke-width="2.3"
						/>
						<rect x="53" y="139.5" width="33" height="6" rx="2.8" fill="#2a1b2e" stroke="none" />
					</g>

					<!-- Right eye -->
					<g>
						<path
							d="M123 144.5 L144 144.5 L144 154.5 C144 161.8 139.5 165.3 133.5 165.3 C127.5 165.3 123 161.8 123 154.5 Z"
							fill="#1567d8"
							stroke="#2a1b2e"
							stroke-width="2.8"
						/>
						<path
							d="M124.8 155 C125.5 161 129.2 163.6 133.5 163.6 C137.8 163.6 141.5 161 142.2 155 C139.4 157.2 136.5 158.2 133.5 158.2 C130.5 158.2 127.6 157.2 124.8 155 Z"
							fill="#39ceff"
							stroke="none"
						/>
						<path
							d="M127.4 148.5 L133.5 153.6 L139.6 148.5 M133.5 153.6 L133.5 162"
							stroke="#edfaff"
							stroke-width="2.4"
						/>
						<rect x="114" y="139" width="36" height="6.2" rx="2.8" fill="#2a1b2e" stroke="none" />
					</g>
				</g>

				<!-- Closed blink frame -->
				<g class="axia-eyes-closed">
					<path d="M54 147 Q71 153 86 146.5" stroke-width="3.6" />
					<path d="M114 146.5 Q133 153 150 147" stroke-width="3.6" />
				</g>

				<!-- Nose dot & smug smile -->
				<circle cx="91" cy="167" r="1.35" fill="#2a1b2e" stroke="none" />
				<path d="M91.5 181 Q104 188 116 179.5" stroke-width="3.2" />
			</g>

			<!-- Layer 6: Three pulsing PJSekai loading dots -->
			<g class="axia-dot axia-dot-1" style="transform-origin: 76px 242px">
				<circle cx="76" cy="242" r="13" fill="#ffffff" />
				<circle cx="76" cy="242" r="8.5" fill="#2a1b2e" />
			</g>
			<g class="axia-dot axia-dot-2" style="transform-origin: 120px 242px">
				<circle cx="120" cy="242" r="13" fill="#ffffff" />
				<circle cx="120" cy="242" r="8.5" fill="#2a1b2e" />
			</g>
			<g class="axia-dot axia-dot-3" style="transform-origin: 164px 242px">
				<circle cx="164" cy="242" r="13" fill="#ffffff" />
				<circle cx="164" cy="242" r="8.5" fill="#2a1b2e" />
			</g>
		</svg>
	</div>
</div>

<noscript>
	<style>
		#axia-loading-screen {
			display: none !important;
		}
	</style>
</noscript>

<style is:global>
	.axia-loader {
		position: fixed;
		inset: 0;
		z-index: 999999;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		pointer-events: none;
		opacity: 1;
		transition: opacity 0.45s ease;
	}

	.axia-loader::before {
		content: "";
		position: absolute;
		inset: 0;
		width: 200%;
		height: 100%;
		background: linear-gradient(90deg, #b3fffd 0%, #e3e6ff 50%, #fde5f5 100%);
		will-change: transform;
	}

	:root.dark .axia-loader::before {
		background: linear-gradient(90deg, #0f1526 0%, #1b2442 50%, #241b3d 100%);
	}

	.axia-loader.is-loaded {
		opacity: 0;
	}

	.axia-loader.is-hidden {
		display: none !important;
	}

	.axia-loader-icon {
		position: relative;
		z-index: 1;
		width: clamp(120px, 32vw, 156px);
	}

	@media (min-width: 768px) {
		.axia-loader-icon {
			width: clamp(140px, 10.5vw, 180px);
		}
	}

	.axia-loader-svg {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Static reduced-motion defaults: calm mid-fill pose, open eyes, visible dots */
	.axia-fill-rect {
		transform: translateY(25%);
		will-change: transform;
	}

	.axia-eyes-closed {
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.axia-loader::before {
			animation: axia-bg-drift 10s ease-in-out infinite;
		}

		.axia-fill-rect {
			animation: axia-hair-rise 1.35s cubic-bezier(0.333, 0, 0.667, 1) 1 both;
		}

		.axia-eyes-open {
			animation: axia-blink-open 1.35s steps(1, end) 1 both;
		}

		.axia-eyes-closed {
			animation: axia-blink-closed 1.35s steps(1, end) 1 both;
		}

		.axia-dot {
			animation: axia-dot-pulse 1.06s cubic-bezier(0.333, 0, 0.667, 1) infinite;
			will-change: transform;
		}

		.axia-dot-2 {
			animation-delay: 0.18s;
		}

		.axia-dot-3 {
			animation-delay: 0.36s;
		}
	}

	@keyframes axia-bg-drift {
		0%,
		100% {
			transform: translate3d(0%, 0, 0);
		}
		50% {
			transform: translate3d(-50%, 0, 0);
		}
	}

	@keyframes axia-hair-rise {
		0% {
			transform: translate3d(0, 100%, 0);
		}
		100% {
			transform: translate3d(0, 0%, 0);
		}
	}

	@keyframes axia-blink-open {
		0%,
		67% {
			opacity: 0;
		}
		68%,
		100% {
			opacity: 1;
		}
	}

	@keyframes axia-blink-closed {
		0%,
		67% {
			opacity: 1;
		}
		68%,
		100% {
			opacity: 0;
		}
	}

	@keyframes axia-dot-pulse {
		0%,
		100% {
			transform: scale(0.67);
		}
		42% {
			transform: scale(1);
		}
		75% {
			transform: scale(0.67);
		}
	}

	@media (forced-colors: active) {
		.axia-loader::before {
			background: Canvas;
		}
		.axia-dot circle:last-child {
			fill: CanvasText;
		}
	}
</style>

<script is:inline data-swup-ignore-script>
	(function () {
		var loader = document.getElementById("axia-loading-screen");
		if (!loader) return;

		try {
			var params = new URLSearchParams(window.location.search);
			if (params.get("preview-loader") === "1") {
				return;
			}
		} catch {}

		var startTime = performance.now();
		var reducedMotion =
			window.matchMedia &&
			window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		var minDisplayMs = reducedMotion ? 80 : 1200;
		var maxDisplayMs = 2400;
		var dismissed = false;

		function finalizeHide() {
			loader.classList.add("is-hidden");
			loader.setAttribute("aria-hidden", "true");
			if (loader.parentNode) {
				loader.parentNode.removeChild(loader);
			}
		}

		function dismissLoader() {
			if (dismissed) return;
			dismissed = true;
			loader.classList.add("is-loaded");

			if (
				reducedMotion ||
				(typeof loader.getAnimations === "function" &&
					loader.getAnimations().length === 0)
			) {
				finalizeHide();
				return;
			}

			var done = false;
			var completeOnce = function () {
				if (done) return;
				done = true;
				finalizeHide();
			};

			loader.addEventListener("transitionend", completeOnce, { once: true });
			window.setTimeout(completeOnce, 600);
		}

		function scheduleDismissOnReady() {
			var elapsed = performance.now() - startTime;
			var remaining = Math.max(0, minDisplayMs - elapsed);
			window.setTimeout(dismissLoader, remaining);
		}

		if (document.readyState === "complete") {
			scheduleDismissOnReady();
		} else {
			window.addEventListener("load", scheduleDismissOnReady, { once: true });
		}

		window.setTimeout(dismissLoader, maxDisplayMs);
	})();
</script>
